{
    "name": "mochi-agent-schema",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "generate": "bun scripts/generate-schema.ts",
        "check:schema": "bun scripts/generate-schema.ts --check",
        "check:types": "tsc --noEmit",
        "test": "bun test",
        "check": "bun run check:types && bun run check:schema && bun test"
    },
    "dependencies": {
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "ajv": "8.20.0",
        "typescript": "5.9.3"
    },
    "overrides": {
        "@types/node": "26.6.5"
    }
}
