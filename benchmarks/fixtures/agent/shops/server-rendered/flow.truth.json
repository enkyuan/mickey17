{
    "schema": "mochi.agent.flow-truth/0.1",
    "mapping": "Plain JSON following docs/AGENT_SURFACE.md D5/D11 until the agent-schema package merges; field mapping is in docs/agent-surface/log/agent-fixtures.md. Authored by hand from server-rendered/render.ts, server-rendered/server.ts, server-rendered/public/enhance.js and shared/core.ts. Never produced by running an extractor.",
    "stack": "server-rendered",
    "origin": "http://shop.test",
    "authoredFrom": [
        "server-rendered/render.ts",
        "server-rendered/server.ts",
        "server-rendered/public/enhance.js",
        "shared/http.ts",
        "shared/core.ts",
        "shared/sign.js"
    ],
    "ignoredRequests": [{"method": "GET", "pathPrefix": "/static/", "reason": "script assets, not flow steps"}],
    "locators": "<requestId>:<location>. Request side: header.<name>, cookie.<name>, url.path[<n>] (0-based, '/'-split, empty segments dropped), url.query.<k>, body.json.<path>, body.form.<field>. Response side: res.json.<path>, res.cookie.<name>, res.header.<name>, res.html.<css>@<attr>.",
    "classes": {
        "constant": "same in every run",
        "input": "varies with caller intent; role 'idempotency-key' marks a caller-minted unique key that needs no site code",
        "derived": "taken from an earlier response, cookie or the page",
        "client-computed": "no source in any recording; produced by site JS (exactly one per stack)"
    },
    "steps": [
        {
            "id": "bootstrap",
            "title": "Open the shop (document + session)",
            "effect": "read",
            "scenarios": ["success", "validation-error", "out-of-stock", "declined"],
            "requests": [
                {
                    "id": "bootstrap",
                    "method": "GET",
                    "path": "/",
                    "values": [],
                    "responses": [{"status": 200, "class": "document"}],
                    "sets": [
                        {"at": "res.cookie.sid", "httpOnly": true, "note": "session id"},
                        {
                            "at": "res.html.input[name=_csrf]@value",
                            "note": "CSRF token as a hidden form field; repeated in every returned form"
                        }
                    ]
                }
            ]
        },
        {
            "id": "catalog",
            "title": "Load products",
            "effect": "read",
            "scenarios": ["success", "validation-error", "out-of-stock", "declined"],
            "requests": [
                {
                    "id": "catalog",
                    "method": "GET",
                    "path": "/catalog",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "header.x-requested-with", "class": "constant", "value": "enhance"}
                    ],
                    "responses": [
                        {
                            "status": 200,
                            "class": "ok",
                            "shape": "fragment#catalog: li[data-sku,data-price,data-stock,data-currency] with <h3> name"
                        }
                    ]
                }
            ]
        },
        {
            "id": "create-cart",
            "title": "Start a cart",
            "effect": "write-reversible",
            "scenarios": ["success", "validation-error", "out-of-stock", "declined"],
            "requests": [
                {
                    "id": "create-cart",
                    "method": "POST",
                    "path": "/carts",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "header.x-csrf-token", "class": "derived"},
                        {
                            "at": "header.content-type",
                            "class": "constant",
                            "value": "application/x-www-form-urlencoded"
                        },
                        {"at": "body.form", "class": "constant", "value": ""}
                    ],
                    "responses": [
                        {
                            "status": 201,
                            "class": "ok",
                            "shape": "fragments alert, catalog, cart(#cart-summary data-cart-id ...), flow"
                        }
                    ]
                }
            ]
        },
        {
            "id": "add-item",
            "title": "Add a product to the cart",
            "effect": "write-reversible",
            "scenarios": ["success", "validation-error", "out-of-stock", "declined"],
            "requests": [
                {
                    "id": "add-item",
                    "method": "POST",
                    "path": "/carts/{cartId}/items",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "cartId"},
                        {"at": "header.x-csrf-token", "class": "derived"},
                        {
                            "at": "header.content-type",
                            "class": "constant",
                            "value": "application/x-www-form-urlencoded"
                        },
                        {
                            "at": "body.form.sku",
                            "class": "input",
                            "name": "sku",
                            "type": "enum",
                            "domainFrom": "catalog:res.html li[data-sku]@data-sku",
                            "encoding": "hidden form field in each product's add form"
                        },
                        {
                            "at": "body.form.quantity",
                            "class": "input",
                            "name": "quantity",
                            "type": "integer",
                            "constraints": {"min": 1, "max": 10},
                            "encoding": "form text, sent as typed"
                        }
                    ],
                    "responses": [
                        {
                            "status": 200,
                            "class": "ok",
                            "scenarios": ["success", "validation-error", "declined"]
                        },
                        {
                            "status": 422,
                            "class": "validation",
                            "code": "validation_failed",
                            "scenarios": ["validation-error"],
                            "fieldsKeys": ["quantity"]
                        },
                        {
                            "status": 409,
                            "class": "conflict",
                            "code": "out_of_stock",
                            "scenarios": ["out-of-stock"]
                        }
                    ]
                }
            ]
        },
        {
            "id": "set-address",
            "title": "Save the shipping address",
            "effect": "write-reversible",
            "scenarios": ["success", "validation-error", "declined"],
            "requests": [
                {
                    "id": "set-address",
                    "method": "POST",
                    "path": "/carts/{cartId}/address",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "cartId"},
                        {"at": "header.x-csrf-token", "class": "derived"},
                        {
                            "at": "header.content-type",
                            "class": "constant",
                            "value": "application/x-www-form-urlencoded"
                        },
                        {
                            "at": "body.form.name",
                            "class": "input",
                            "name": "name",
                            "type": "string",
                            "constraints": {"required": true, "maxLength": 80}
                        },
                        {
                            "at": "body.form.line1",
                            "class": "input",
                            "name": "line1",
                            "type": "string",
                            "constraints": {"required": true}
                        },
                        {
                            "at": "body.form.city",
                            "class": "input",
                            "name": "city",
                            "type": "string",
                            "constraints": {"required": true}
                        },
                        {
                            "at": "body.form.region",
                            "class": "input",
                            "name": "region",
                            "type": "string",
                            "constraints": {"pattern": "^[A-Za-z]{2}$"}
                        },
                        {
                            "at": "body.form.postalCode",
                            "class": "input",
                            "name": "postalCode",
                            "type": "string",
                            "constraints": {"pattern": "^\\d{5}$"}
                        },
                        {
                            "at": "body.form.country",
                            "class": "input",
                            "name": "country",
                            "type": "string",
                            "constraints": {"enum": ["US"]},
                            "default": "US"
                        }
                    ],
                    "responses": [
                        {
                            "status": 200,
                            "class": "ok",
                            "scenarios": ["success", "validation-error", "declined"]
                        },
                        {
                            "status": 422,
                            "class": "validation",
                            "code": "validation_failed",
                            "scenarios": ["validation-error"],
                            "fieldsKeys": ["name", "region", "postalCode"]
                        }
                    ]
                }
            ]
        },
        {
            "id": "shipping-rates",
            "title": "Fetch shipping rates (a data-get slot loads right after the address is saved)",
            "effect": "read",
            "scenarios": ["success", "validation-error", "declined"],
            "requests": [
                {
                    "id": "shipping-rates",
                    "method": "GET",
                    "path": "/carts/{cartId}/shipping-rates",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "cartId"},
                        {"at": "header.x-requested-with", "class": "constant", "value": "enhance"}
                    ],
                    "responses": [
                        {
                            "status": 200,
                            "class": "ok",
                            "shape": "fragment#rates: form with input[type=radio name=rate value,data-rate-label,data-rate-cents,data-rate-eta]"
                        }
                    ]
                }
            ]
        },
        {
            "id": "select-shipping",
            "title": "Choose a shipping rate",
            "effect": "write-reversible",
            "scenarios": ["success", "validation-error", "declined"],
            "requests": [
                {
                    "id": "select-shipping",
                    "method": "POST",
                    "path": "/carts/{cartId}/shipping-rate",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "cartId"},
                        {"at": "header.x-csrf-token", "class": "derived"},
                        {
                            "at": "header.content-type",
                            "class": "constant",
                            "value": "application/x-www-form-urlencoded"
                        },
                        {
                            "at": "body.form.rate",
                            "class": "derived",
                            "name": "rateId",
                            "choice": "one of shipping-rates:res.html input[name=rate]@value, picked by data-rate-label (Standard|Express)",
                            "wireName": "rate"
                        }
                    ],
                    "responses": [{"status": 200, "class": "ok"}]
                }
            ]
        },
        {
            "id": "tokenize-payment",
            "title": "Hosted-field-style tokenization (test stub; no card data)",
            "effect": "write-reversible",
            "scenarios": ["success", "validation-error", "declined"],
            "requests": [
                {
                    "id": "tokenize-payment",
                    "method": "POST",
                    "path": "/payments-stub/v1/tokens",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "header.content-type", "class": "constant", "value": "application/json"},
                        {
                            "at": "body.json.method",
                            "class": "input",
                            "name": "method",
                            "type": "enum",
                            "constraints": {"enum": ["test_ok", "test_declined"]}
                        }
                    ],
                    "responses": [{"status": 201, "class": "ok", "shape": "{token}"}],
                    "payment": {
                        "hostedField": true,
                        "tokenOnly": true,
                        "note": "no card numbers exist anywhere in the fixture; the method id selects the outcome"
                    }
                }
            ]
        },
        {
            "id": "place-order",
            "title": "Place the order (payment)",
            "effect": "financial",
            "idempotent": true,
            "scenarios": ["success", "validation-error", "declined"],
            "requests": [
                {
                    "id": "place-order",
                    "method": "POST",
                    "path": "/carts/{cartId}/orders",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "cartId"},
                        {"at": "header.x-csrf-token", "class": "derived"},
                        {
                            "at": "header.content-type",
                            "class": "constant",
                            "value": "application/x-www-form-urlencoded"
                        },
                        {
                            "at": "header.idempotency-key",
                            "class": "input",
                            "role": "idempotency-key",
                            "generator": "uuid-v4",
                            "origin": "client-generated",
                            "note": "minted by enhance.js (crypto.randomUUID()) on first submit of the payment form; the executor may mint its own"
                        },
                        {
                            "at": "header.x-signature",
                            "class": "client-computed",
                            "function": "sign(timestampMs, rawBody)",
                            "producer": "shared/sign.js",
                            "inputs": ["Date.now()", "body.form (the exact urlencoded string)"],
                            "format": "v1.<timestamp ms>.<14 hex>",
                            "serverCheck": "recomputed over the raw body; timestamp within 5 min of the server clock"
                        },
                        {"at": "body.form.paymentToken", "class": "derived", "name": "paymentToken"}
                    ],
                    "responses": [
                        {
                            "status": 201,
                            "class": "ok",
                            "scenarios": ["success", "validation-error"],
                            "shape": "fragments with #confirmation[data-order-id,...] (full order as data-* attributes) and an #order-status slot"
                        },
                        {
                            "status": 402,
                            "class": "payment-declined",
                            "code": "card_declined",
                            "scenarios": ["declined"]
                        }
                    ]
                }
            ]
        },
        {
            "id": "order-status",
            "title": "Read the order (confirmation screen)",
            "effect": "read",
            "scenarios": ["success", "validation-error"],
            "requests": [
                {
                    "id": "order-status",
                    "method": "GET",
                    "path": "/orders/{orderId}",
                    "values": [
                        {"at": "cookie.sid", "class": "derived", "automatic": true},
                        {"at": "url.path[1]", "class": "derived", "name": "orderId"},
                        {"at": "header.x-requested-with", "class": "constant", "value": "enhance"}
                    ],
                    "responses": [
                        {
                            "status": 200,
                            "class": "ok",
                            "shape": "fragment#order-status[data-order-id,data-status,...] + line items"
                        }
                    ]
                }
            ]
        }
    ],
    "edges": [
        {
            "from": "bootstrap:res.cookie.sid",
            "to": [
                "catalog:cookie.sid",
                "create-cart:cookie.sid",
                "add-item:cookie.sid",
                "set-address:cookie.sid",
                "shipping-rates:cookie.sid",
                "select-shipping:cookie.sid",
                "tokenize-payment:cookie.sid",
                "place-order:cookie.sid",
                "order-status:cookie.sid"
            ],
            "via": "cookie jar"
        },
        {
            "from": "bootstrap:res.html.input[name=_csrf]@value",
            "to": [
                "create-cart:header.x-csrf-token",
                "add-item:header.x-csrf-token",
                "set-address:header.x-csrf-token",
                "select-shipping:header.x-csrf-token",
                "place-order:header.x-csrf-token"
            ],
            "via": "hidden form field (page) -> header (enhance.js removes it from the body); the same token is re-rendered in every returned form"
        },
        {
            "from": "create-cart:res.html.#cart-summary@data-cart-id",
            "to": [
                "add-item:url.path[1]",
                "set-address:url.path[1]",
                "shipping-rates:url.path[1]",
                "select-shipping:url.path[1]",
                "place-order:url.path[1]"
            ],
            "via": "response HTML attribute -> URL segment (also present in later form action attributes)"
        },
        {
            "from": "shipping-rates:res.html.input[name=rate]@value",
            "to": "select-shipping:body.form.rate",
            "via": "response HTML (chosen radio) -> form field"
        },
        {
            "from": "tokenize-payment:res.json.token",
            "to": "place-order:body.form.paymentToken",
            "via": "response JSON -> form field (enhance.js)"
        },
        {
            "from": "place-order:res.html.#confirmation@data-order-id",
            "to": "order-status:url.path[1]",
            "via": "response HTML attribute -> URL segment (also in the #order-status data-get attribute)"
        }
    ],
    "stateDependencies": [
        {
            "step": "set-address",
            "requires": ["add-item"],
            "reason": "address form only appears once the cart has an item"
        },
        {"step": "shipping-rates", "requires": ["set-address"], "server": "409 address_required otherwise"},
        {
            "step": "select-shipping",
            "requires": ["shipping-rates"],
            "server": "422 unless rateId is in the latest quote"
        },
        {
            "step": "place-order",
            "requires": ["select-shipping", "tokenize-payment"],
            "server": "409 cart_incomplete without address or rate"
        }
    ],
    "controls": [
        {
            "mutate": "omit or alter the x-csrf-token header (and the _csrf field) on any POST",
            "expect": {"status": 403, "code": "csrf_invalid"}
        },
        {
            "mutate": "alter x-signature, or sign a different body",
            "expect": {"status": 401, "code": "invalid_signature"}
        },
        {
            "mutate": "x-signature timestamp more than 5 minutes from the server clock",
            "expect": {"status": 401, "code": "signature_expired"}
        },
        {"mutate": "omit idempotency-key", "expect": {"status": 400, "code": "idempotency_key_required"}},
        {
            "mutate": "replay place-order with the same key and body",
            "expect": {"status": 201, "header": "idempotent-replayed: true", "sameOrderId": true}
        },
        {
            "mutate": "reuse the key with a different payment token",
            "expect": {"status": 422, "code": "idempotency_key_reuse"}
        },
        {"mutate": "stale or foreign cartId in the URL", "expect": {"status": 404, "code": "cart_not_found"}},
        {"mutate": "reuse a payment token", "expect": {"status": 422, "code": "invalid_payment_token"}}
    ],
    "clientComputedCount": 1
}
